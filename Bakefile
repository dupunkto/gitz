#!/usr/bin/env bash

PORT=4000
ENTRYPOINT=dev.php

# Configure the PHP server to start two concurrent threads.
export PHP_CLI_SERVER_WORKERS=2
export SCAN_PATH="$HOME/downloads/git"

setup() {
  required composer
  composer install
}

serve() {
  php -S 0.0.0.0:$PORT $ENTRYPOINT
}

deploy() {
  lift deploy
}